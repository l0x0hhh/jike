# ---- Supabase 配置（必填，否则自动降级为 localStorage 本地演示模式）----
# 获取路径：Supabase 控制台 → Project → Project Settings → API
#   1) Project URL 填到 NEXT_PUBLIC_SUPABASE_URL
#   2) anon public key 填到 NEXT_PUBLIC_SUPABASE_ANON_KEY

NEXT_PUBLIC_SUPABASE_URL=https://你的项目id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon_public_key
